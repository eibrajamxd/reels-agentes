# --- Claude (agentes) ---
# claude-code = los agentes usan Claude Code con tu plan de claude.ai (sin costo extra; consume tus límites)
# api = usan la API con ANTHROPIC_API_KEY (pago por uso)
MOTOR_IA=claude-code
ANTHROPIC_API_KEY=sk-ant-...

# --- Videos de stock gratis (https://www.pexels.com/api/) ---
# Opcional: sin esta clave se usan fondos animados generados.
PEXELS_API_KEY=

# --- Instagram (cuenta Profesional: Creador o Empresa) ---
# Token de Instagram (ver README, sección 2). Nunca lo compartas.
# Token "Unified login" (empieza con EAA)  -> IG_API_BASE=https://graph.facebook.com
# Token "Instagram login" (empieza con IG) -> IG_API_BASE=https://graph.instagram.com
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_BASE=https://graph.facebook.com
IG_API_VERSION=v23.0

# --- Canal ---
CANAL_NOMBRE=¿Cómo Funciona?
CANAL_HANDLE=@como_funcionatv
ZONA_HORARIA=America/Santiago
# País del público al que se dirige el canal (ajusta lenguaje, ejemplos y hashtags)
PUBLICO=Chile
# Voz del narrador: escúchalas con `python main.py voces` y elige con `python main.py elegir-voz <nombre>`
VOZ=es-MX-JorgeNeural
VELOCIDAD_VOZ=+8%
PUBLICACIONES_MAX_POR_DIA=1
# manual = el video y el texto quedan en la carpeta CARPETA_LISTOS y tú lo subes desde la app
# automatica = el vigilante lo publica solo en Instagram
MODO_PUBLICACION=manual
CARPETA_LISTOS=~/Desktop/Reels listos
# (solo modo automática) true = cada video queda "pendiente_revision" hasta que lo apruebes
REVISION_MANUAL=true

# --- Animación ---
# animacion = todas las escenas animadas | mixto = alterna animación y stock | broll = solo stock
MODO_VISUAL=animacion
# pelicula = estilo dibujado a mano (skill procedural-film) | plano = gráficos planos
ESTILO_ANIMACION=pelicula
